# Copy to .env and fill in. Never commit .env.

# ---- LLM (used by the investigation agent) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Pick a model that supports tool calling. Check OpenAI's models page for the
# current list and pricing, and choose the cheapest one that passes your evals.
OPENAI_MODEL=gpt-5-mini
# Optional: point at any OpenAI-compatible endpoint (for example a local
# Ollama server at http://localhost:11434/v1). Leave blank for OpenAI itself.
OPENAI_BASE_URL=

# ---- Snowflake (only needed with --warehouse snowflake) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=
# Use ONE of the two auth options below. Key-pair is preferred for service use.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PASSWORD=
